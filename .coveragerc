[run]
# Coverage configuration
source = src
omit = 
    */tests/*
    */test_*.py
    */conftest.py
    */venv/*
    */virtualenv/*
    */__pycache__/*
    */migrations/*
    */settings/*
    */manage.py
    */wsgi.py
    */asgi.py

[report]
# Reporting configuration
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

ignore_errors = True
show_missing = True
precision = 2
skip_covered = False
skip_empty = False

[html]
directory = htmlcov
title = Native Scraping Test Coverage Report

[xml]
output = coverage.xml