# Test Environment Variables
# Copy this file to .env.test and update with your test values

# Database
TEST_DATABASE_URL=sqlite:///./test_ris_scraping.db

# API Settings
TEST_API_HOST=localhost
TEST_API_PORT=8001

# Frontend Settings
TEST_FRONTEND_HOST=localhost
TEST_FRONTEND_PORT=3001

# External Services
MOCK_FIRECRAWL=true
MOCK_SUPABASE=true

# If you want to test with real services, set these
# FIRECRAWL_API_KEY=your_test_api_key
# SUPABASE_URL=your_test_supabase_url
# SUPABASE_ANON_KEY=your_test_anon_key

# Performance Testing
LOAD_TEST_USERS=10
LOAD_TEST_DURATION=60

# Coverage
MIN_COVERAGE_PERCENT=80

# Timeouts
DEFAULT_TIMEOUT=30
SCRAPING_TIMEOUT=300